# Copy this file to .env (local) or add these to Replit Secrets.
# Never commit your real .env file.

# Signs session cookies. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HARGASYNC_SECRET_KEY=change-me
# Where the SQLite database and private invoice uploads live.
HARGASYNC_DATA_DIR=data
# Set to 1 when served over HTTPS (Replit deployments) so cookies are Secure.
HTTPS_ONLY=0

# Invoice reading: runpod | fixture (simulated, labelled in the UI) | off (manual entry only).
# Defaults to runpod when both RunPod values are set, otherwise fixture.
AI_MODE=fixture
RUNPOD_API_KEY=your-runpod-api-key
RUNPOD_ENDPOINT_ID=your-endpoint-id

# Seed fictional demo shops, users and products into an empty database.
DEMO_SEED=1
# Password for every demo account (owner_ali, staff_mei, auditor_raj, owner_siti).
DEMO_PASSWORD=demo1234
