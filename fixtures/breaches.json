{
  "_note": "Synthetic planted rule violations. Each case must be intercepted by the pricing rules (expected flag, status, role or cap). Ceilings here are fictional.",
  "item": {"code": "ayam_standard", "unit": "kg", "district": "Petaling", "retail_level": "runcit", "on": "2026-10-23"},
  "limit_template": {
    "id": 1, "item_code": "ayam_standard", "unit": "kg", "district": "Petaling", "retail_level": "runcit",
    "max_price_sen": 900, "valid_from": "2026-10-01", "valid_to": "2026-11-30", "verification": "verified",
    "source_ref": "synthetic test ceiling"
  },
  "cases": [
    {"name": "Suggested price above verified ceiling", "controlled": true, "limit": {},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"flag": "capped", "max_price_sen": 900}},
    {"name": "Demo ceiling is labelled, never treated as verified", "controlled": true, "limit": {"verification": "demo"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"flag": "demo_ceiling"}},
    {"name": "Expired ceiling", "controlled": true, "limit": {"valid_to": "2026-10-22"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"status": "blocked"}},
    {"name": "Ceiling not yet in force", "controlled": true, "limit": {"valid_from": "2026-10-24"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"status": "blocked"}},
    {"name": "Ceiling for another district", "controlled": true, "limit": {"district": "Klang"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"status": "blocked"}},
    {"name": "Ceiling for another unit", "controlled": true, "limit": {"unit": "ekor"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"status": "blocked"}},
    {"name": "Ceiling for wholesale level, shop is retail", "controlled": true, "limit": {"retail_level": "borong"},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"status": "blocked"}},
    {"name": "Controlled item with valid ceiling still needs the owner", "controlled": true, "limit": {"max_price_sen": 5000},
     "old_cost_sen": 800, "new_cost_sen": 800, "current_price_sen": 1000, "target_margin": "0.20",
     "expect": {"required_role": "owner"}},
    {"name": "Supplier cost up 16%", "controlled": false, "limit": null,
     "old_cost_sen": 1000, "new_cost_sen": 1160, "current_price_sen": 1450, "target_margin": "0.20",
     "expect": {"flag": "cost_jump", "required_role": "owner"}},
    {"name": "Supplier cost up 50%", "controlled": false, "limit": null,
     "old_cost_sen": 1000, "new_cost_sen": 1500, "current_price_sen": 1250, "target_margin": "0.20",
     "expect": {"flag": "cost_jump"}},
    {"name": "Ceiling forces a price below cost", "controlled": true, "limit": {"max_price_sen": 900},
     "old_cost_sen": 950, "new_cost_sen": 950, "current_price_sen": 900, "target_margin": "0.20",
     "expect": {"flag": "below_cost"}},
    {"name": "Price change over 5% routed to owner", "controlled": false, "limit": null,
     "old_cost_sen": 848, "new_cost_sen": 848, "current_price_sen": 1000, "target_margin": "0.20",
     "expect": {"flag": "large_change", "required_role": "owner"}},
    {"name": "First price for a new product routed to owner", "controlled": false, "limit": null,
     "old_cost_sen": 0, "new_cost_sen": 500, "current_price_sen": null, "target_margin": "0.20",
     "expect": {"flag": "new_product", "required_role": "owner"}}
  ]
}
